[Unit]
Description=Docker DNS sync daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dnsync
Group=dnsync
# Uncomment when using a local Docker socket with group-based access.
# SupplementaryGroups=docker
EnvironmentFile=-/etc/dnsync/dnsync.env
ExecStart=/usr/local/bin/dnsync -config /etc/dnsync/config.toml
Restart=on-failure
RestartSec=5s
WorkingDirectory=/var/lib/dnsync
StateDirectory=dnsync
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
